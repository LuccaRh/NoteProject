# *.localhost resolves to 127.0.0.1 without /etc/hosts
notes.localhost {
    # Certificate from Caddy's own local CA (kept in the caddy_data volume)
    tls internal

    # Each API prefix goes to its own service, which sees no /api:
    # /api/notes -> ichiro:8000/notes, /api/chat -> lonzo:8000/chat
    @nujabes path /api/auth /api/auth/*
    handle @nujabes {
        uri strip_prefix /api
        reverse_proxy nujabes:8000
    }

    @ichiro path /api/notes /api/notes/*
    handle @ichiro {
        uri strip_prefix /api
        reverse_proxy ichiro:8000
    }

    @lonzo path /api/chat /api/chat/*
    handle @lonzo {
        uri strip_prefix /api
        reverse_proxy lonzo:8000
    }

    # An API path no service owns: 404, never the front
    handle /api/* {
        respond 404
    }

    # Everything else is the front, served by the Vite dev server
    handle {
        reverse_proxy chimchar:5173
    }
}
