<mxCell id="legenda" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;anúncio&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;antes de qualquer pacote, cada dono de bloco avisa os vizinhos (BGP: &amp;#x27;cheguem a 142.250.0.0/15 por mim&amp;#x27;); cada vizinho anota de quem ouviu e repassa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;1–4&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;o pacote sobe só até um roteador que conhece o bloco e desce rumo ao dono; cada pulo é uma consulta à tabela, sem busca&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;o roteador do Google entrega ao servidor pela rede local dele&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;IP novo&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;site novo costuma pegar IP de um bloco do provedor, já anunciado; bloco novo é dado pelo registro da região (LACNIC) e anunciado&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;fonte&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;(geral); blocos ilustrativos, salvo 142.250.0.0/15, que é do Google (de memória)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="1137" height="116" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
