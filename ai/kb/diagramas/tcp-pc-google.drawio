<mxCell id="legenda" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;A&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;origem 192.168.15.156:51234 → destino 142.250.79.36:443 (IP privado, só vale no wi-fi)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;B&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;o NAT troca só a origem: 203.0.113.7:51234 → 142.250.79.36:443; daqui até o Google nada muda no pacote&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;rotas&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;cada roteador olha só o destino, acha o bloco mais específico que o contém na própria tabela e manda ao vizinho daquela linha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;C&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;pacote novo: origem 142.250.79.36:443 → destino 203.0.113.7:51234; roteado do zero, pode seguir outro caminho&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;D&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;o NAT acha a porta 51234 na tabela e troca o destino por 192.168.15.156:51234&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;ex.&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;IPs e blocos ilustrativos (faixas de documentação 203.0.113.x e 198.51.100.x)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;fonte&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;rotas do notebook: ip route em 2026-10-24; o resto (geral)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="135" y="720" width="962" height="160" as="geometry"/></mxCell>
