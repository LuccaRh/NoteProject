<mxCell id="te1" value="1. mensagem&lt;br&gt;no terminal" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="112" width="110" height="56" as="geometry"/></mxCell>
<mxCell id="cc0" value="2. recebe a mensagem&lt;br&gt;(sessão aberta na pasta&lt;br&gt;do projeto)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="650" y="102" width="190" height="76" as="geometry"/></mxCell>
<mxCell id="di1" value="lê CLAUDE.md (+ imports @),&lt;br&gt;cabeçalho de .claude/skills/*,&lt;br&gt;settings.json (hooks)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="325" y="252" width="240" height="76" as="geometry"/></mxCell>
<mxCell id="cc1" value="3. pacote 1:&lt;br&gt;system (CLAUDE.md, skills)&lt;br&gt;+ tools + histórico" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="252" width="210" height="76" as="geometry"/></mxCell>
<mxCell id="an1" value="4. modelo entende a pergunta&lt;br&gt;e não tem o arquivo:&lt;br&gt;tool_use Grep(&#x27;caddy&#x27;)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="930" y="252" width="230" height="76" as="geometry"/></mxCell>
<mxCell id="di2" value="grep em ai/obsidian/&lt;br&gt;→ &#x27;.../Caddy.md:12&#x27;" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="360" y="412" width="170" height="56" as="geometry"/></mxCell>
<mxCell id="cc2" value="5. auto mode aprova;&lt;br&gt;executa o Grep&lt;br&gt;pacote 2 = 1 + resultado" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="645" y="402" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="an2" value="6. já sabe o caminho:&lt;br&gt;tool_use Read(&#x27;.../Caddy.md&#x27;)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="930" y="412" width="230" height="56" as="geometry"/></mxCell>
<mxCell id="di3" value="abre o arquivo&lt;br&gt;(hook leitura confere&lt;br&gt;o tamanho antes)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="355" y="552" width="180" height="76" as="geometry"/></mxCell>
<mxCell id="cc3" value="7. executa o Read&lt;br&gt;pacote 3 = pacote 2&lt;br&gt;+ texto com nº de linha" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="650" y="552" width="190" height="76" as="geometry"/></mxCell>
<mxCell id="an3" value="8. decide as mudanças:&lt;br&gt;Edit(Caddy.md, velho → novo)&lt;br&gt;Write(&#x27;TLS.md&#x27;, texto)&lt;br&gt;Bash(&#x27;rm rascunho.md&#x27;)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="930" y="542" width="230" height="96" as="geometry"/></mxCell>
<mxCell id="di4" value="troca o trecho, cria&lt;br&gt;o arquivo, apaga o outro&lt;br&gt;no disco do PC" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="345" y="702" width="200" height="76" as="geometry"/></mxCell>
<mxCell id="cc4" value="9. auto mode aprova;&lt;br&gt;executa as três&lt;br&gt;pacote 4 = 3 + ok" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="702" width="170" height="76" as="geometry"/></mxCell>
<mxCell id="an4" value="10. nada mais a pedir:&lt;br&gt;só texto (&#x27;atualizei Caddy,&lt;br&gt;criei TLS, apaguei rascunho&#x27;)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="930" y="702" width="230" height="76" as="geometry"/></mxCell>
<mxCell id="cc5" value="11. grava a conversa&lt;br&gt;(transcript .jsonl em ~/.claude/)&lt;br&gt;e mostra o texto aos pedaços" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="615" y="852" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="te2" value="12. resposta no terminal;&lt;br&gt;o Obsidian vê os arquivos&lt;br&gt;mudados" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="852" width="210" height="76" as="geometry"/></mxCell>
