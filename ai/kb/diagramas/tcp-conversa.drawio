<mxCell id="legenda" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;seq&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;número do primeiro byte que este pacote carrega (o SYN e o FIN contam como 1 byte)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;ack&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;o próximo byte que espero do outro lado = recebi tudo antes dele&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;IPs&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;todo pacote leva também os IPs de origem e destino (os da linha de cima); aqui só as portas, para caber&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;perda&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;se o ack 1501 não volta a tempo, o notebook reenvia o pacote 4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;números&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;ilustrativos; o começo (100, 500) é sorteado a cada conexão; o lado do Google também manda o seu FIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;fonte&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;(geral), RFC 9293 seção 3.4&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="105" y="708" width="822" height="138" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
