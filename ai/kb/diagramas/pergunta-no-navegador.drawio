<mxCell id="gas" value="" style="rounded=1;arcSize=4;dashed=1;html=1;fontSize=12;container=0;fillColor=#f5f5f5;strokeColor=#666666;opacity=60;" vertex="1" parent="1"><mxGeometry x="625" y="70" width="260" height="878" as="geometry"/></mxCell>
<mxCell id="gan" value="" style="rounded=1;arcSize=4;dashed=1;html=1;fontSize=12;container=0;fillColor=#f5f5f5;strokeColor=#666666;opacity=60;" vertex="1" parent="1"><mxGeometry x="920" y="210" width="270" height="588" as="geometry"/></mxCell>
<mxCell id="gno" value="" style="rounded=1;arcSize=4;dashed=1;html=1;fontSize=12;container=0;fillColor=#f5f5f5;strokeColor=#666666;opacity=60;" vertex="1" parent="1"><mxGeometry x="345" y="210" width="220" height="588" as="geometry"/></mxCell>
<mxCell id="nav1" value="1. pergunta no chat&lt;br&gt;POST /api/chat&lt;br&gt;{workspace, conversa, pergunta}" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="102" width="230" height="76" as="geometry"/></mxCell>
<mxCell id="as0" value="2. recebe a pergunta&lt;br&gt;(o Caddy encaminhou)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="670" y="112" width="170" height="56" as="geometry"/></mxCell>
<mxCell id="no1" value="lê .workspace/:&lt;br&gt;regras + cabeçalho&lt;br&gt;das skills" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="375" y="252" width="160" height="76" as="geometry"/></mxCell>
<mxCell id="as1" value="3. pacote 1:&lt;br&gt;system (regras, índice)&lt;br&gt;+ tools + histórico" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="252" width="190" height="76" as="geometry"/></mxCell>
<mxCell id="an1" value="4. modelo entende a pergunta&lt;br&gt;e não tem a nota:&lt;br&gt;tool_use search_notes(&#x27;caddy&#x27;)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="940" y="252" width="230" height="76" as="geometry"/></mxCell>
<mxCell id="no2" value="busca no Postgres&lt;br&gt;→ [{id 42, &#x27;Caddy&#x27;}]" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="375" y="412" width="160" height="56" as="geometry"/></mxCell>
<mxCell id="as2" value="5. executa search_notes&lt;br&gt;pacote 2 = pacote 1&lt;br&gt;+ pedido + resultado" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="665" y="402" width="180" height="76" as="geometry"/></mxCell>
<mxCell id="an2" value="6. já sabe o id:&lt;br&gt;tool_use read_note(42)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="970" y="412" width="170" height="56" as="geometry"/></mxCell>
<mxCell id="no3" value="SELECT da nota 42" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="570" width="150" height="40" as="geometry"/></mxCell>
<mxCell id="as3" value="7. executa read_note&lt;br&gt;pacote 3 = pacote 2&lt;br&gt;+ texto da nota" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="675" y="552" width="160" height="76" as="geometry"/></mxCell>
<mxCell id="an3" value="8. decide as mudanças:&lt;br&gt;edit_note(42, velho → novo)&lt;br&gt;create_note(&#x27;TLS&#x27;, texto)&lt;br&gt;delete_note(57)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="950" y="542" width="210" height="96" as="geometry"/></mxCell>
<mxCell id="no4" value="PATCH 42, POST &#x27;TLS&#x27;,&lt;br&gt;DELETE 57&lt;br&gt;→ Postgres" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="365" y="702" width="180" height="76" as="geometry"/></mxCell>
<mxCell id="as4" value="9. executa as três&lt;br&gt;pacote 4 = pacote 3&lt;br&gt;+ &#x27;ok&#x27; de cada uma" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="675" y="702" width="160" height="76" as="geometry"/></mxCell>
<mxCell id="an4" value="10. nada mais a pedir:&lt;br&gt;só texto (&#x27;atualizei Caddy,&lt;br&gt;criei TLS, apaguei 57&#x27;)" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="945" y="702" width="220" height="76" as="geometry"/></mxCell>
<mxCell id="as5" value="11. grava a conversa&lt;br&gt;(banco do lonzo)&lt;br&gt;e manda o texto aos pedaços" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="645" y="852" width="220" height="76" as="geometry"/></mxCell>
<mxCell id="nav2" value="12. mostra a resposta;&lt;br&gt;a lista de notas&lt;br&gt;recarrega" style="html=1;whiteSpace=wrap;fontSize=12;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="65" y="852" width="180" height="76" as="geometry"/></mxCell>
