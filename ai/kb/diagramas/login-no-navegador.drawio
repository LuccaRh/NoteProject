<mxCell id="ped__titulo" value="&lt;b&gt;Cada pedido de notas ou de chat&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="26" y="423" width="233" height="18" as="geometry"/></mxCell>
<mxCell id="e0__rotulo" value="1. POST /api/auth/login&lt;br&gt;email + senha (HTTPS)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="252" y="123" width="177" height="36" as="geometry"/></mxCell>
<mxCell id="e1__rotulo" value="2. repassa" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="742" y="141" width="86" height="18" as="geometry"/></mxCell>
<mxCell id="e2__rotulo" value="3. confere a senha com crypt()&lt;br&gt;grava o hash do token" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1112" y="123" width="226" height="36" as="geometry"/></mxCell>
<mxCell id="e5__rotulo" value="1. GET /api/notes&lt;br&gt;Cookie: session=token" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="266" y="473" width="163" height="36" as="geometry"/></mxCell>
<mxCell id="e6__rotulo" value="2. pergunta, com o cookie&lt;br&gt;3. volta 200 + X-User-Id,&lt;br&gt;ou 401 sem sessão" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="574" y="572" width="191" height="54" as="geometry"/></mxCell>
<mxCell id="e7__rotulo" value="busca o&lt;br&gt;hash do token" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="749" y="648" width="107" height="36" as="geometry"/></mxCell>
<mxCell id="e8__rotulo" value="4. pedido + X-User-Id&lt;br&gt;(com 401, para aqui)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="701" y="473" width="163" height="36" as="geometry"/></mxCell>
<mxCell id="e9__rotulo" value="5. SQL igual,&lt;br&gt;filtrado pela policy" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1162" y="473" width="156" height="36" as="geometry"/></mxCell>
<mxCell id="legenda" value="&lt;table style=&quot;border-collapse:collapse;font-size:12px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;token&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;aleatório, sem id nem senha dentro; a tabela guarda só o hash&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;X-User-Id&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:left&quot;&gt;só existe depois do Caddy; o navegador não consegue escolher o valor&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="782" width="591" height="50" as="geometry"/></mxCell>
