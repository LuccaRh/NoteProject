# Copy to .env (git ignores it) and replace every value.

# Database user created by the postgres image on its first start
POSTGRES_USER=example
# Password of that user
POSTGRES_PASSWORD=example
# Database created on the first start
POSTGRES_DB=example

# Read by the notes API and Alembic; same user, password and database as
# above. The host "postgres" is the compose service name (inside the
# containers); make check swaps it for localhost.
DATABASE_URL=postgresql+psycopg://example:example@postgres:5432/example

# Read by lonzo only; one key for every chat until there is a login
ANTHROPIC_API_KEY=example
