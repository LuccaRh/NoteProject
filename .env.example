# Copy to .env (git ignores it) and replace every value.
#
# Each service has two users, read on the first start only (postgres/init):
# the app user, which only reads and writes rows, and the migrator, which
# owns the tables and runs Alembic. In the URLs, the host "postgres" is the
# compose service name; make check swaps it for localhost.

# Superuser and the database it connects to, made by the postgres image
POSTGRES_USER=example
POSTGRES_PASSWORD=example
POSTGRES_DB=postgres
DRIVER=postgresql+psycopg

# ichiro
ICHIRO_DB_PASSWORD=example
ICHIRO_MIGRATOR_PASSWORD=example
ICHIRO_DATABASE_URL=postgresql+psycopg://ichiro:example@postgres:5432/ichiro
ICHIRO_MIGRATION_URL=${DRIVER}://ichiro_migrator:example@postgres:5432/ichiro

# lonzo; one Anthropic key for every chat
LONZO_DB_PASSWORD=example
LONZO_MIGRATOR_PASSWORD=example
LONZO_DATABASE_URL=postgresql+psycopg://lonzo:example@postgres:5432/lonzo
LONZO_MIGRATION_URL=${DRIVER}://lonzo_migrator:example@postgres:5432/lonzo
ANTHROPIC_API_KEY=example

# nujabes
NUJABES_DB_PASSWORD=example
NUJABES_DATABASE_URL=postgresql+psycopg://nujabes:example@postgres:5432/nujabes
NUJABES_MIGRATION_URL=${DRIVER}://nujabes_migrator:example@postgres:5432/nujabes
